{
	"name": "@nanahuse/racetime-protocol",
	"version": "0.8.0",
	"description": "Public NodeCG RaceTime integration contract",
	"license": "Apache-2.0",
	"type": "module",
	"files": ["dist", "README.md"],
	"exports": {
		".": {
			"import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node finalize.cjs",
		"prepack": "pnpm build"
	},
	"publishConfig": { "access": "public" },
	"dependencies": { "@js-temporal/polyfill": "^0.5.1" },
	"devDependencies": { "typescript": "^5.9.3" }
}
