{
	"name": "racetime-integration",
	"version": "0.5.0",
	"private": true,
	"description": "Shared RaceTime monitoring and category mappings for NodeCG",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm build:extension && pnpm build:dashboard",
		"build:extension": "pnpm --filter @nanahuse/racetime-protocol build && node scripts/build.mjs",
		"build:dashboard": "vite build --config vite.dashboard.config.mts",
		"dev": "pnpm build && node scripts/build.mjs --watch",
		"start": "nodecg start",
		"typecheck": "pnpm --filter @nanahuse/racetime-protocol build && tsc --noEmit && tsc -p tsconfig.dashboard.json --noEmit",
		"test": "pnpm build:extension && vitest run --dir test",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"nodecg": {
		"compatibleRange": "^2.8.0",
		"bundleDependencies": {
			"player-manager": "^3.0.0"
		},
		"dashboardPanels": [
			{
				"name": "racetime-integration",
				"title": "RaceTime Integration",
				"file": "racetime-integration.html",
				"fullbleed": true
			}
		]
	},
	"dependencies": {
		"@googleapis/sheets": "^18.0.0",
		"@js-temporal/polyfill": "^0.5.1",
		"@nanahuse/player-manager-protocol": "github:Nanahuse/player-manager#v3.0.0&path:/packages/player-manager-protocol",
		"@nanahuse/racetime-protocol": "workspace:*",
		"google-auth-library": "^11.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@nodecg/types": "^2.8.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.13.6",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.0",
		"esbuild": "^0.27.0",
		"jsdom": "^30.1.2",
		"nodecg": "^2.8.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.0",
		"vitest": "^4.0.0"
	}
}
