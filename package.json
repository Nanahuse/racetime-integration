{
	"name": "racetime-integration",
	"version": "0.1.0",
	"private": true,
	"description": "Shared RaceTime monitoring and category mappings for NodeCG",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm --filter @nanahuse/racetime-protocol build && node scripts/build.mjs",
		"dev": "pnpm build && node scripts/build.mjs --watch",
		"start": "nodecg start",
		"typecheck": "pnpm --filter @nanahuse/racetime-protocol build && tsc --noEmit",
		"test": "pnpm build && vitest run --dir test",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"nodecg": {
		"compatibleRange": "^2.8.0",
		"bundleDependencies": {
			"player-manager": "^2.2.1"
		}
	},
	"dependencies": {
		"@nanahuse/racetime-protocol": "workspace:*",
		"@googleapis/sheets": "^18.0.0",
		"google-auth-library": "^11.1.0",
		"@nanahuse/player-manager-protocol": "github:Nanahuse/player-manager#85ef6e5f78503f443b61627fc08c4a9675850cb0&path:/packages/player-manager-protocol"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@nodecg/types": "^2.8.0",
		"@types/node": "^24.13.6",
		"esbuild": "^0.27.0",
		"nodecg": "^2.8.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.0"
	}
}
